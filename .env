# Development settings. Load with `source .env` before `cargo run` or `pnpm dev`.
# Every backend setting is read at runtime; see the tables in
# rustsystem-server/src/config.rs and rustsystem-trustauth/src/config.rs.

# Frontend (build time): show the /dev pages.
export DEV=true

# ── Server (rustsystem-server) ───────────────────────────────────────────────
# The server also reads TRUSTAUTH_PUBLIC_URL (below) and hands it to the frontend.
export SERVER_PUBLIC_URL="http://localhost:1443"
export TRUSTAUTH_INTERNAL_URL="https://localhost:2444"
export MEETINGS_DIR="meetings"
export FRONTEND_DIR="frontend/dist"

# ── Trustauth (rustsystem-trustauth) ─────────────────────────────────────────
export TRUSTAUTH_PUBLIC_URL="http://localhost:2443"
# The origins the voter page is served from: the server, and the Vite dev server.
export SERVER_PUBLIC_URLS="http://localhost:1443,http://localhost:3000"

# ── mTLS between them (generate with: cd mtls && bash mkcerts.sh dev) ────────
# Each service uses its own certificate; run_dev.sh sets MTLS_CERT/MTLS_KEY per service.
export MTLS_CA_CERT="mtls/ca/ca.crt"
