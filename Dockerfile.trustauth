# Rustsystem trustauth: logins and blind signatures.
#
#   docker build -f Dockerfile.trustauth -t rustsystem-trustauth .
#
# Expects mTLS certificates in mtls-prod/ (deploy.sh generates them). Every setting is a
# runtime environment variable (see rustsystem-trustauth/src/config.rs); the defaults below
# are production's.

FROM rust:1.91-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY rustsystem-core/ ./rustsystem-core/
COPY rustsystem-server/ ./rustsystem-server/
COPY rustsystem-trustauth/ ./rustsystem-trustauth/
COPY decrypt-tally/ ./decrypt-tally/
RUN cargo build --release --bin rustsystem-trustauth

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/rustsystem-trustauth ./rustsystem-trustauth
COPY mtls-prod/ca/ca.crt mtls-prod/trustauth/trustauth.crt mtls-prod/trustauth/trustauth.key ./mtls/

ENV TRUSTAUTH_PUBLIC_URL=https://rosta.trustauth.fsektionen.se \
    SERVER_PUBLIC_URLS=https://rosta.fsektionen.se \
    TRUSTAUTH_PUBLIC_ADDR=0.0.0.0:2443 \
    TRUSTAUTH_INTERNAL_ADDR=0.0.0.0:2444 \
    MTLS_CA_CERT=/app/mtls/ca.crt \
    MTLS_CERT=/app/mtls/trustauth.crt \
    MTLS_KEY=/app/mtls/trustauth.key

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 2443 2444
CMD ["./rustsystem-trustauth"]
