# Rustsystem server: the API and the built frontend.
#
#   docker build -f Dockerfile.server -t rustsystem-server .
#
# Expects mTLS certificates in mtls-prod/ (deploy.sh generates them). Every setting is a
# runtime environment variable (see rustsystem-server/src/config.rs); the defaults below are
# production's, so `docker run` needs no extra configuration there.

FROM node:24-bookworm AS frontend-builder
# Pinned to match frontend/package.json's packageManager, so builds can't drift.
RUN npm install -g pnpm@10.11.0
WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ .
ARG DEV=false
RUN --mount=type=bind,source=.git,target=/app/frontend/.git pnpm run build

FROM rust:1.91-bookworm AS backend-builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY rustsystem-core/ ./rustsystem-core/
COPY rustsystem-server/ ./rustsystem-server/
COPY rustsystem-trustauth/ ./rustsystem-trustauth/
COPY decrypt-tally/ ./decrypt-tally/
RUN cargo build --release --bin rustsystem-server

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend-builder /app/target/release/rustsystem-server ./rustsystem-server
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist
COPY mtls-prod/ca/ca.crt mtls-prod/server/server.crt mtls-prod/server/server.key ./mtls/

ENV SERVER_PUBLIC_URL=https://rosta.fsektionen.se \
    TRUSTAUTH_PUBLIC_URL=https://rosta.trustauth.fsektionen.se \
    TRUSTAUTH_INTERNAL_URL=https://rustsystem-trustauth:2444 \
    SERVER_PUBLIC_ADDR=0.0.0.0:1443 \
    MTLS_CA_CERT=/app/mtls/ca.crt \
    MTLS_CERT=/app/mtls/server.crt \
    MTLS_KEY=/app/mtls/server.key \
    MEETINGS_DIR=/app/meetings \
    FRONTEND_DIR=/app/frontend/dist

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 1443
CMD ["./rustsystem-server"]
